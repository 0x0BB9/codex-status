{
  "name": "codex-status-floater",
  "private": true,
  "version": "0.1.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prepare:codex-sidecar": "node scripts/prepare-codex-sidecar.mjs",
    "preview": "vite preview",
    "protocol:generate": "codex app-server generate-ts --out src/generated",
    "server:listen": "codex app-server --listen ws://127.0.0.1:48123",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "tauri:dev": "tauri dev",
    "windows:build": "tauri build --bundles nsis,msi",
    "mac:sign:adhoc": "codesign --force --deep --sign - 'src-tauri/target/release/bundle/macos/Codex Status Floater.app'",
    "mac:dmg:adhoc": "hdiutil create -volname 'Codex Status Floater' -srcfolder 'src-tauri/target/release/bundle/macos/Codex Status Floater.app' -ov -format UDZO 'src-tauri/target/release/bundle/dmg/Codex Status Floater_0.1.9_aarch64_adhoc.dmg'",
    "mac:package:adhoc": "pnpm tauri:build && pnpm mac:sign:adhoc && pnpm mac:dmg:adhoc"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@openai/codex": "0.146.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "packageManager": "pnpm@10.34.4"
}
