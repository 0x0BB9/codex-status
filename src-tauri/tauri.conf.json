{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Status Floater",
  "version": "0.1.2",
  "identifier": "io.github.codexstatus.floater",
  "build": {
    "beforeDevCommand": "pnpm prepare:codex-sidecar && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm prepare:codex-sidecar && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Status Floater",
        "width": 430,
        "height": 860,
        "minWidth": 360,
        "minHeight": 620,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "resizable": true,
        "transparent": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/codex-app-server"],
    "resources": [
      "../THIRD_PARTY_NOTICES.md",
      "patches/tauri/LICENSE_APACHE-2.0"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
